{
  "name": "katiecrafts.com",
  "version": "2.1.0",
  "type": "module",
  "description": "Katie Crafts blog - migrated from WordPress to Astro",
  "homepage": "https://www.katiecrafts.com",
  "bugs": {
    "url": "https://github.com/seriouslysean/katiecrafts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/seriouslysean/katiecrafts.git"
  },
  "license": "MIT",
  "author": "Sean Kennedy <sean@codeserious.com>",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && cp CNAME dist/CNAME",
    "tool:import-wordpress": "tsx tools/import-wordpress.ts",
    "tool:cleanup-posts": "tsx tools/cleanup-posts.ts",
    "tool:export-posts": "tsx tools/export-posts.ts",
    "new-post": "tsx tools/new-post.ts",
    "lint": "oxlint . --ignore-path .oxlintignore",
    "lint:fix": "oxlint . --fix --ignore-path .oxlintignore",
    "typecheck": "astro sync && tsc --noEmit",
    "audit:content": "tsx tools/audit-content.ts",
    "audit:links": "lychee --config lychee.toml --remap \"https?://(www[.])?katiecrafts[.]com file://$PWD/dist\" dist",
    "audit:html": "html-validate \"dist/**/*.html\"",
    "audit": "npm run audit:content && npm run build && npm run audit:html && npm run audit:links"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "^7.4.2",
    "entities": "^8.1.0",
    "minisearch": "^7.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/yargs": "^17.0.35",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "html-validate": "^11.17.0",
    "node-html-parser": "^9.0.5",
    "oxlint": "^1.89.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "yargs": "^18.2.0"
  }
}
